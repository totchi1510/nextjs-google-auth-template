NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-random-secret

# Register NEXTAUTH_URL + /api/auth/callback/google in Google Cloud.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ALLOWED_EMAIL_DOMAINS=s.okayama-u.ac.jp,okayama-u.ac.jp
# Google Workspace's hd claim may use the parent domain for student accounts.
ALLOWED_GOOGLE_HOSTED_DOMAINS=s.okayama-u.ac.jp,okayama-u.ac.jp
